{
  "name": "lawyer-workbench",
  "description": "Local-first legal workspace for independent lawyers",
  "author": "Riven-Wood",
  "license": "UNLICENSED",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "check": "npm test && npx tsc -b --pretty false && vite build && node --check electron/main.cjs",
    "clean": "node -e \"const fs=require('fs');['dist','release'].forEach(d=>fs.rmSync(d,{recursive:true,force:true}))\"",
    "build": "npm run clean && tsc -b && vite build",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "desktop:dev": "vite",
    "dist:mac": "npm run clean && npm run build && electron-builder --mac",
    "dist:win": "npm run clean && npm run build && electron-builder --win",
    "dist:linux": "npm run clean && npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "date-fns": "^3.6.0",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "com.lawyer.workbench",
    "productName": "Legal Work Space",
    "artifactName": "Legal-Work-Space-${version}-${os}-${arch}.${ext}",
    "releaseInfo": {
      "releaseName": "Legal Work Space v1.0.0",
      "releaseNotesFile": "build/release-notes.md"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "artifactName": "Legal-Work-Space-${version}-linux-x64.${ext}",
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    },
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "Riven-Wood",
      "repo": "legal-work-space"
    },
    "electronDist": "node_modules/electron/dist"
  }
}
